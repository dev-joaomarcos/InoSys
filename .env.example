# Copie este arquivo para `.env` e ajuste os valores. Nunca commite o `.env`.

# Chave secreta do Django (obrigatória). Use um valor longo e aleatório.
SECRET_KEY=replace-with-a-long-random-secret

# True só em desenvolvimento. Em produção, use False.
DEBUG=True

# Hosts permitidos, separados por vírgula e sem https://.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para POST, com esquema e separadas por vírgula.
# Necessário em produção (ex.: https://seu-app.up.railway.app).
# CSRF_TRUSTED_ORIGINS=https://seu-app.up.railway.app

# URL de conexão do PostgreSQL. Se ficar comentada, usa SQLite local (db.sqlite3).
# DATABASE_URL=postgres://usuario:senha@localhost:5432/inosys
