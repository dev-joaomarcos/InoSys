# Copie para .env e ajuste. O .env nunca entra no Git.

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Só em produção: origem completa, com https://
# CSRF_TRUSTED_ORIGINS=https://seu-app.up.railway.app

# Sem DATABASE_URL o projeto usa db.sqlite3. Para PostgreSQL:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/inosys

# Minutos sem uso até a sessão expirar (padrão: 60). Ela também expira ao fechar o navegador.
# SESSAO_MINUTOS=60

# Administrador inicial, criado por "python manage.py criar_admin" se ainda não existir.
# A senha vale só para o primeiro acesso: o sistema obriga a troca.
# ADMIN_USUARIO=admin
# ADMIN_SENHA=
# ADMIN_NOME=Administrador
