# Copie este arquivo para `.env` e ajuste os valores. Nunca commite o `.env`.
# Em produção (Railway), estas mesmas variáveis são configuradas no painel do serviço.

# Chave secreta do Django (obrigatória). Use um valor longo e aleatório.
# Para gerar uma: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-a-long-random-secret

# True só em desenvolvimento. Em produção, use False.
# Com False, o Django força HTTPS, cookies seguros e HSTS (ver SECURE_HSTS_SECONDS).
DEBUG=True

# Hosts permitidos, separados por vírgula e sem https://.
# Com DEBUG=False e este campo vazio, toda requisição recebe erro 400.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para POST, com esquema e separadas por vírgula.
# Necessário em produção (ex.: https://seu-app.up.railway.app).
# CSRF_TRUSTED_ORIGINS=https://seu-app.up.railway.app

# URL de conexão do PostgreSQL. Se ficar comentada, usa SQLite local (db.sqlite3).
# DATABASE_URL=postgres://usuario:senha@localhost:5432/inosys

# Só vale com DEBUG=False. Tempo, em segundos, que o navegador deve exigir HTTPS neste
# domínio. Padrão: 3600 (1 hora). O navegador guarda o valor e não dá para desfazer antes
# do prazo, então suba aos poucos depois de validar o HTTPS:
#   86400 (1 dia) -> 2592000 (30 dias) -> 31536000 (1 ano, só em produção estável).
# SECURE_HSTS_SECONDS=3600
